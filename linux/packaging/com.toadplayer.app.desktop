[Desktop Entry]
Type=Application
Version=1.4
Name=Toadplayer
GenericName=Music Player
Comment=Play, organize and download your music library
Exec=toadplayer %U
Icon=com.toadplayer.app
Terminal=false
StartupNotify=true
StartupWMClass=com.toadplayer.app
Categories=AudioVideo;Audio;Player;Music;
Keywords=music;player;audio;flac;library;
MimeType=x-scheme-handler/toadplayer;audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/opus;application/ogg;audio/x-wav;audio/wav;audio/aac;audio/mp4;audio/x-aiff;
